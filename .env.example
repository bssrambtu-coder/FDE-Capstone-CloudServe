# Copy this file to .env and fill in your own values.
# Add .env to .gitignore before you put a real key in it.

OPENROUTER_API_KEY=your_key_here
MODEL_NAME=deepseek/deepseek-v4-flash-0731:free
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5

# Retrieval relevance floor. Derived by sweeping the development set; see
# docs/decisions.md. Below this, retrieval returns nothing rather than
# something irrelevant.
RETRIEVAL_FLOOR=0.42

# Retrieval backend. "hybrid" is the audited configuration and the one the
# fairness condition holds under; it needs the extras in requirements.txt.
# "lexical" needs nothing installed but reopens the gap in R-07.
RETRIEVAL_BACKEND=hybrid
SEMANTIC_GATE=0.60

# Batch monitoring (B-12). 0 leaves the temporary batch exporter off. The API
# separately exposes /metrics/prometheus on its own port.
METRICS_PORT=0

# Resilience
PROVIDER_TIMEOUT_S=20
PROVIDER_MAX_RETRIES=3

# Induce a failure condition for A11 testing:
# outage | timeout | ratelimit | malformed. Leave empty in normal operation.
FAULT_MODE=
